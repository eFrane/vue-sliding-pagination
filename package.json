{
  "name": "vue-sliding-pagination",
  "version": "3.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/eFrane/vue-sliding-pagination"
  },
  "homepage": "https://vue-sliding-pagination.efrane.com",
  "description": "Sliding pagination component",
  "author": "eFrane <efrane@meanderingsoul.com>",
  "license": "MIT",
  "main": "dist/vue-sliding-pagination.umd.js",
  "module": "dist/vue-sliding-pagination.esm.js",
  "jsnext:main": "dist/vue-sliding-pagination.esm.js",
  "unpkg": "dist/browser/vue-sliding-pagination.min.js",
  "keywords": [
    "pagination",
    "vue",
    "sliding window",
    "moving window"
  ],
  "scripts": {
    "build": "rimraf ./dist && webpack --config webpack.config.js",
    "unit": "jest --config test/unit/jest.conf.js",
    "prepare": "yarn run lint",
    "prepack": "yarn run test && yarn run build",
    "tdd": "yarn run unit --watch",
    "test:unit": "yarn run unit --coverage",
    "docs:dev": "cd docs && yarn dev",
    "docs:build": "cd docs && yarn build",
    "docs:preview": "cd docs && yarn preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test": "yarn test:unit && yarn test:e2e",
    "lint": "eslint --ext .js,.vue src test",
    "pr": "yarn && yarn prepack && echo 'Please check if the documentation still works'"
  },
  "dependencies": {
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@babel/core": "^7.13.0",
    "@babel/plugin-transform-runtime": "^7.24.7",
    "@babel/preset-env": "^7.25.3",
    "@playwright/test": "^1.64.1",
    "@vue/compiler-sfc": "^3.1.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/vue3-jest": "^29.2.6",
    "babel-eslint": "^10.1.0",
    "babel-jest": "^27.0.6",
    "babel-loader": "^8.0.0",
    "babel-plugin-dynamic-import-node": "^2.3.0",
    "babel-plugin-transform-es2015-modules-commonjs": "^6.26.0",
    "css-loader": "^7.1.5",
    "eslint": "^7.14.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.7.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^5.1.0",
    "eslint-plugin-standard": "^5.0.0",
    "eslint-plugin-vue": "^9.17.0",
    "jest": "^27.0.6",
    "jest-serializer-vue": "^3.1.0",
    "mini-css-extract-plugin": "^2.9.1",
    "rimraf": "^5.0.1",
    "vue-loader": "^16.8.3",
    "webpack": "^5.1.3",
    "webpack-cli": "^5.1.4",
    "webpack-merge": "^6.0.1"
  },
  "engines": {
    "node": ">= 18.3.0",
    "npm": ">= 8.11.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ],
  "packageManager": "yarn@4.8.1"
}
